# Copy to .env (next to your main compose file) and fill in the token.
#
# The SAM 3 weights are gated on Hugging Face. Request access at
# https://huggingface.co/facebook/sam3, then create a read token at
# https://huggingface.co/settings/tokens.

HF_TOKEN=

# DDS domain shared by the container and its consumers.
ROS_DOMAIN_ID=0

# Optional overrides used by compose.sam3.yaml
# SAM3_DEVICE=cuda
# SAM3_TEXT_PROMPT=red mug
# SAM3_IMAGE_TOPIC=/camera/color/image_raw
# SAM3_GPUS=all
# SAM3_WEIGHTS_VOLUME=sam3-weights
# SAM3_CONFIG_DIR=./src/sam3_ros/config
